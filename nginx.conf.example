# ─────────────────────────────────────────────────────────────
# HiTek + ICMR DB OSINT (Legacy v1) — Production Nginx Template
# ─────────────────────────────────────────────────────────────
# Replace 'api.yourdomain.com' with your VPS IP or public domain.
#
# Option A: API Only (Decoupled frontend hosted on Cloudflare Pages/Vercel)
# Option B: Unified Server (Nginx serves both static website/ and proxies /api)
# ─────────────────────────────────────────────────────────────

# Upstream API Daemon
upstream hitek_backend {
    server 127.0.0.1:8000 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# HTTP — Redirect all traffic to HTTPS (Recommended for Production)
server {
    listen 80;
    listen [::]:80;
    server_name api.yourdomain.com your-vps-ip;

    # Certbot challenge path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect to HTTPS once SSL certificate is installed
    # location / {
    #     return 301 https://$host$request_uri;
    # }

    # Before SSL is enabled, use standard proxy:
    location / {
        proxy_pass http://hitek_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for multi-hop BFS graph traversals
        proxy_connect_timeout 15s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;

        # Buffer sizing
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 16k;
    }
}

