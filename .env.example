# ─────────────────────────────────────────────────────────────
# HiTek + ICMR DB OSINT (Legacy v1) — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────

# Database Configuration
# Absolute path to your local SQLite database containing HiTek (users) and/or ICMR tables
DB_PATH=/data/users.db

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Performance & Traversal Limits
MAX_RESULTS=25              # Max rows per individual table query
MAX_GLOBAL_RESULTS=100      # Global record ceiling per lookup profile
DEEP_SEARCH_DEPTH=3         # Number of BFS relational hops (1 to 5)
DB_RETRY_ATTEMPTS=3         # Concurrency retry attempts on SQLite busy/lock
DB_RETRY_DELAY=0.5          # Exponential backoff base delay in seconds

# Rate Limiting (Protects server from scrapers and high concurrency load)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60      # Max requests per window
RATE_LIMIT_WINDOW_SECONDS=60
TRUSTED_PROXY_COUNT=1       # Number of reverse proxies in front (for X-Forwarded-For IP extraction)

# Optional Authentication (Disabled by default for open self-hosting)
API_AUTH_ENABLED=false
API_KEY=your_secret_api_key_here

# CORS Origins (Comma-separated or * for wildcard)
CORS_ORIGINS=*
